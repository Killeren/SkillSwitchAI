# Together.ai Multi-Agent Chat System Configuration

# Together.ai API Key (Required)
# Get your free API key from https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=your_together_ai_api_key_here

# Optional: FastAPI Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Optional: Model Selection Settings
MAX_ITERATIONS=3
DEFAULT_MODEL_TIMEOUT=30

# Optional: Session Settings
SESSION_TIMEOUT=3600
MAX_CHAT_HISTORY=20
